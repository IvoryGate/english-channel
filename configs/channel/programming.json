      {"id": "philosophy", "examples": ["stoicism", "control", "meaning", "mortality", "mindfulness"]}
    ],
    "safety": {
      "medicalClaimsRequirePrimarySources": true,
      "attributedQuotesRequireVerification": true,
      "genericCelebrityVoiceImitationForbidden": true
    }
  },
  "trendResearch": {
    "runDay": "monday",
